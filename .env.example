# --- model provider -------------------------------------------------------
PROVIDER=mock                     # mock (offline, replays sample ground truth) | anthropic
ANTHROPIC_API_KEY=                # server-side only; never sent to the browser
ANTHROPIC_BASE_URL=               # optional: gateway/proxy URL; leave empty for the default API
ANTHROPIC_MODEL=claude-sonnet-5-5
VERIFY_MODE=second_pass           # second_pass (2nd independent read) | none

# --- limits and cost protection ------------------------------------------
INVOICE_TIMEOUT_S=90              # hard time budget per invoice
MODEL_CALL_TIMEOUT_S=45
DAILY_MODEL_CALL_CAP=300          # global cap on model calls per UTC day
UPLOADS_PER_VISITOR_PER_HOUR=30
UPLOADS_PER_IP_PER_HOUR=60
MAX_FILE_BYTES=8388608
MAX_FILES_PER_UPLOAD=10

# --- demo privacy ---------------------------------------------------------
VISITOR_TTL_HOURS=24              # visitor data is deleted after this much inactivity
FILE_TTL_HOURS=2                  # uploaded files are deleted much earlier
COOKIE_SECURE=0                   # set 1 behind HTTPS
TRUST_PROXY=0                     # set 1 behind a reverse proxy that sets X-Forwarded-For

# --- accounting rules -----------------------------------------------------
VAT_RATE=0.10                     # configurable; confirm with your accountant
